# Perplexica veille - root crontab fragment (Monday/Tuesday, Europe/Paris)
# Monday: historical full-run window.
# Tuesday: recovery-only window for the previous Monday's .partial marker.
0 3,4,5,6 * * 1 su -s /bin/sh - nicolas -c '/volume1/home/nicolas/Docker/openai-adapter/tools/perplexica/monday_veille_wrapper.sh' >> /volume1/Web/logs/perplexica_veille.log 2>&1
45 7 * * 1 su -s /bin/sh - nicolas -c '/volume1/home/nicolas/Docker/openai-adapter/tools/perplexica/monday_veille_wrapper.sh' >> /volume1/Web/logs/perplexica_veille.log 2>&1
0 3,4,5,6 * * 2 su -s /bin/sh - nicolas -c '/volume1/home/nicolas/Docker/openai-adapter/tools/perplexica/monday_veille_wrapper.sh' >> /volume1/Web/logs/perplexica_veille.log 2>&1
